#!/usr/bin/env bash
# =============================================================================
# wp-aliases — Manage and explore WP-CLI alias shortcuts
# =============================================================================
# Installed by WP-CLI-aliases setup. Provides a post-install interface
# for listing, searching, and learning about available aliases.
#
# USAGE:
#   wp-aliases [COMMAND] [OPTIONS]
#
# COMMANDS:
#   list                List all installed aliases
#   list --category CAT List aliases for a specific category
#   categories          List all available categories
#   search TERM         Search aliases by name or description
#   man                 Show the full man page
#   help, --help, -h    Show this help message
# =============================================================================

set -euo pipefail

# ── Find the WP-CLI-aliases installation directory ───────────────────────────
# 1. Prefer the environment variable set during install
# 2. Fall back to the directory relative to this script (symlink-safe)
if [[ -n "${WP_CLI_ALIASES_DIR:-}" && -d "$WP_CLI_ALIASES_DIR" ]]; then
    INSTALL_DIR="$WP_CLI_ALIASES_DIR"
else
    # Resolve symlinks to find the real script location
    SOURCE="${BASH_SOURCE[0]}"
    while [[ -L "$SOURCE" ]]; do
        SOURCE="$(readlink "$SOURCE")"
    done
    INSTALL_DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
fi

readonly ALIASES_DIR="${INSTALL_DIR}/aliases"
readonly POPULAR_FILE="${INSTALL_DIR}/popular.sh"
readonly MAN_PAGE="${INSTALL_DIR}/docs/wp-aliases.1"

# ── Colours ───────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
    CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; DIM=''; RESET=''
fi

# ── Category descriptions ─────────────────────────────────────────────────────
declare -A CATEGORY_DESC=(
    [cache]="Object cache & transients"
    [comment]="Create, moderate, and delete comments"
    [config]="Manage wp-config.php constants and salts"
    [core]="Download, install, and update WordPress core"
    [cron]="List, run, and manage WP-Cron events"
    [db]="Import, export, query, and maintain the database"
    [eval]="Execute PHP inline or from a file"
    [import-export]="Import/export content via WXR files"
    [media]="Import media and regenerate thumbnails"
    [option]="Get, update, and delete WordPress options"
    [package]="Install and manage WP-CLI community packages"
    [plugin]="Install, activate, update, and delete plugins"
    [post]="Create, list, update, and delete posts"
    [rewrite]="Flush and manage rewrite rules"
    [role]="Manage roles and capabilities"
    [scaffold]="Generate plugin/theme/CPT boilerplate"
    [search-replace]="Search and replace strings in the database"
    [term]="Create and manage taxonomy terms"
    [theme]="Install, activate, update, and delete themes"
    [user]="Create, list, update, and delete users"
    [popular]="Curated popular/recommended aliases"
)

# ── Parse alias lines from a file ────────────────────────────────────────────
# Outputs: "alias_name   →  expansion   # comment"
parse_aliases() {
    local file="$1"
    [[ -f "$file" ]] || return 0

    grep -E "^alias [a-zA-Z_]" "$file" | \
    sed -E "s/^alias ([^=]+)='([^']+)'[[:space:]]*(#[[:space:]]*(.*))?$/\1\t\2\t\4/" | \
    while IFS=$'\t' read -r name expansion comment; do
        printf "  ${BOLD}%-18s${RESET} ${CYAN}→${RESET}  %-45s ${DIM}%s${RESET}\n" \
            "$name" "$expansion" "$comment"
    done
}

# ── List command ─────────────────────────────────────────────────────────────
cmd_list() {
    local filter_cat="${1:-}"

    if [[ -n "$filter_cat" ]]; then
        local file
        if [[ "$filter_cat" == "popular" ]]; then
            file="$POPULAR_FILE"
        else
            file="${ALIASES_DIR}/${filter_cat}.sh"
        fi

        if [[ ! -f "$file" ]]; then
            echo -e "${RED}Unknown category '${filter_cat}'${RESET}" >&2
            echo "Run 'wp-aliases categories' to see available categories." >&2
            exit 1
        fi

        echo ""
        echo -e "${BOLD}Category: ${CYAN}${filter_cat}${RESET}"
        if [[ -n "${CATEGORY_DESC[$filter_cat]:-}" ]]; then
            echo -e "  ${DIM}${CATEGORY_DESC[$filter_cat]}${RESET}"
        fi
        echo ""
        parse_aliases "$file"
        echo ""
        return 0
    fi

    # List all
    echo ""
    echo -e "${BOLD}All WP-CLI Aliases${RESET}"
    echo ""

    # popular first
    if [[ -f "$POPULAR_FILE" ]]; then
        echo -e "  ${BOLD}${YELLOW}── popular ──────────────────────────────────${RESET}"
        parse_aliases "$POPULAR_FILE"
        echo ""
    fi

    for file in "${ALIASES_DIR}"/*.sh; do
        [[ -f "$file" ]] || continue
        local cat
        cat="$(basename "$file" .sh)"
        echo -e "  ${BOLD}${YELLOW}── ${cat} ──────────────────────────────────${RESET}"
        parse_aliases "$file"
        echo ""
    done
}

# ── Categories command ────────────────────────────────────────────────────────
cmd_categories() {
    echo ""
    echo -e "${BOLD}Available Alias Categories${RESET}"
    echo ""
    echo -e "  ${BOLD}${YELLOW}popular${RESET}  ${DIM}— Curated popular/recommended aliases (start here)${RESET}"
    echo ""

    for f in "${ALIASES_DIR}"/*.sh; do
        [[ -f "$f" ]] || continue
        local cat
        cat="$(basename "$f" .sh)"
        local desc="${CATEGORY_DESC[$cat]:-}"
        printf "  ${BOLD}%-20s${RESET}  ${DIM}%s${RESET}\n" "$cat" "$desc"
    done
    echo ""
    echo -e "  Install a category:  ${YELLOW}${INSTALL_DIR}/install.sh --category NAME${RESET}"
    echo ""
}

# ── Search command ────────────────────────────────────────────────────────────
cmd_search() {
    local term="${1:-}"
    if [[ -z "$term" ]]; then
        echo "Usage: wp-aliases search TERM" >&2
        exit 1
    fi

    echo ""
    echo -e "${BOLD}Search results for:${RESET} ${CYAN}${term}${RESET}"
    echo ""

    local found=0
    local all_files=("$POPULAR_FILE" "${ALIASES_DIR}"/*.sh)

    for file in "${all_files[@]}"; do
        [[ -f "$file" ]] || continue
        local matches
        matches="$(grep -iE "alias.*${term}|#.*${term}" "$file" 2>/dev/null || true)"
        if [[ -n "$matches" ]]; then
            local cat
            cat="$(basename "$file" .sh)"
            echo -e "  ${BOLD}${YELLOW}[${cat}]${RESET}"
            parse_aliases "$file" | grep -i "$term" || true
            echo ""
            found=1
        fi
    done

    if [[ $found -eq 0 ]]; then
        echo -e "  ${DIM}No aliases found matching '${term}'${RESET}"
    fi
    echo ""
}

# ── Man page command ──────────────────────────────────────────────────────────
cmd_man() {
    if [[ -f "$MAN_PAGE" ]] && command -v man &>/dev/null; then
        man "$MAN_PAGE"
    else
        # Fallback: show formatted help
        show_help
    fi
}

# ── Help ──────────────────────────────────────────────────────────────────────
show_help() {
    cat <<EOF

${BOLD}wp-aliases${RESET} — Manage WP-CLI shortcut aliases

${BOLD}USAGE${RESET}
    wp-aliases COMMAND [OPTIONS]

${BOLD}COMMANDS${RESET}
    list                      List all aliases across all categories
    list --category CAT       List aliases for a specific category
    list --category popular   List the popular/recommended aliases
    categories                Show all available categories with descriptions
    search TERM               Search aliases by name or description keyword
    man                       Display the full man page
    help, --help, -h          Show this help message

${BOLD}EXAMPLES${RESET}
    wp-aliases list
    wp-aliases list --category plugin
    wp-aliases categories
    wp-aliases search "plugin install"
    wp-aliases search cache
    wp-aliases man

${BOLD}ALIAS NAMING CONVENTION${RESET}
    All aliases follow the pattern:  wp + [category-prefix] + [action]

    Category prefixes:
      wpc     = wp core          wpp    = wp plugin       wpt    = wp theme
      wppo    = wp post          wpu    = wp user         wpop   = wp option
      wpdb    = wp db            wpcfg  = wp config       wpsr   = wp search-replace
      wpca    = wp cache         wpcr   = wp cron         wptm   = wp term
      wpcom   = wp comment       wpmdi  = wp media        wprw   = wp rewrite
      wprl    = wp role          wpcap  = wp cap          wpscaf = wp scaffold
      wppkg   = wp package       wpimp  = wp import       wpexp  = wp export
      wpev    = wp eval          wpevf  = wp eval-file    wptr   = wp transient

    Common action suffixes:
      i = install   a = activate   d = deactivate   l = list    u = update
      c = create    g = get        r = delete/remove s = status  f = flush
      e = export    m/i = import   ck = check/verify ver = version

${BOLD}INSTALLATION DIRECTORY${RESET}
    ${INSTALL_DIR}

EOF
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    local cmd="${1:-help}"

    case "$cmd" in
        list)
            shift || true
            local cat_filter=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --category|-c)
                        [[ -z "${2:-}" ]] && { echo "--category requires a NAME" >&2; exit 1; }
                        cat_filter="$2"
                        shift 2
                        ;;
                    *) shift ;;
                esac
            done
            cmd_list "$cat_filter"
            ;;
        categories|cats)
            cmd_categories
            ;;
        search)
            shift || true
            cmd_search "${1:-}"
            ;;
        man)
            cmd_man
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            echo -e "${RED}Unknown command: '${cmd}'${RESET}" >&2
            echo "Run 'wp-aliases help' for usage." >&2
            exit 1
            ;;
    esac
}

main "$@"
